# Set default behavior to automatically normalize text files and enforce LF line endings
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf

# Explicit binary files
*.idx binary
*.qsv.idx binary
*.zip binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
